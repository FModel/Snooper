layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

const uint MAX_LIGHTS_PER_CLUSTER = 256;

struct LightData
{
    vec3 position;
    float range;
    vec3 color;
    uint type; // 0 = point, 1 = spot
    vec3 direction;
    float spotAngle;
    float spotOuterAngle;
    float intensity;
    uint padding1;
    uint padding2;
};

struct ClusterAABB
{
    vec3 minPoint;
    float _padding1;
    vec3 maxPoint;
    float _padding2;
};

struct ClusterData
{
    uint offset;
    uint count;
};

layout(std430, binding = 0) readonly buffer LightBuffer
{
    LightData lights[];
};

layout(std430, binding = 1) readonly buffer ClusterAABBs
{
    ClusterAABB clusters[];
};

layout(std430, binding = 2) writeonly buffer ClusterDataBuffer
{
    ClusterData clusterData[];
};

layout(std430, binding = 3) writeonly buffer LightIndexList
{
    uint lightIndices[];
};

layout(std430, binding = 4) buffer GlobalIndexCount
{
    uint globalIndexCount;
};

uniform int uLightCount;
uniform int uGridDimX;
uniform int uGridDimY;
uniform int uGridDimZ;
uniform mat4 uViewMatrix;

shared uint sharedLightCount;
shared uint sharedLightIndices[MAX_LIGHTS_PER_CLUSTER];
shared uint sharedGlobalOffset;

// Test if sphere intersects AABB
bool SphereIntersectsAABB(vec3 center, float radius, vec3 minPoint, vec3 maxPoint)
{
    // Add adaptive epsilon based on light size - smaller lights need more padding
    float EPSILON = max(0.1, radius * 0.2);
    vec3 expandedMin = minPoint - vec3(EPSILON);
    vec3 expandedMax = maxPoint + vec3(EPSILON);

    vec3 closestPoint = clamp(center, expandedMin, expandedMax);
    vec3 distance = center - closestPoint;

    // Use slightly larger effective radius for culling
    float effectiveRadius = radius + EPSILON;
    return dot(distance, distance) <= effectiveRadius * effectiveRadius;
}

// Test if cone intersects AABB (improved conservative test)
bool ConeIntersectsAABB(vec3 tipPos, vec3 direction, float range, float cosAngle, vec3 minPoint, vec3 maxPoint)
{
    // Add epsilon padding for spot lights too
    const float EPSILON = 0.1; // Larger epsilon for spot lights
    vec3 expandedMin = minPoint - vec3(EPSILON);
    vec3 expandedMax = maxPoint + vec3(EPSILON);

    // Conservative approach: use the cone's bounding sphere first
    vec3 coneEnd = tipPos + direction * range;
    float coneRadius = range * sqrt(1.0 - cosAngle * cosAngle);
    vec3 sphereCenter = tipPos + direction * (range * 0.5);
    float sphereRadius = length(sphereCenter - tipPos) + coneRadius;

    // If bounding sphere doesn't intersect, cone definitely doesn't
    if (!SphereIntersectsAABB(sphereCenter, sphereRadius, expandedMin, expandedMax))
        return false;

    // Test all 8 corners of the AABB
    vec3 corners[8];
    corners[0] = expandedMin;
    corners[1] = vec3(expandedMax.x, expandedMin.y, expandedMin.z);
    corners[2] = vec3(expandedMin.x, expandedMax.y, expandedMin.z);
    corners[3] = vec3(expandedMax.x, expandedMax.y, expandedMin.z);
    corners[4] = vec3(expandedMin.x, expandedMin.y, expandedMax.z);
    corners[5] = vec3(expandedMax.x, expandedMin.y, expandedMax.z);
    corners[6] = vec3(expandedMin.x, expandedMax.y, expandedMax.z);
    corners[7] = expandedMax;

    // Check if any corner is inside the cone
    bool anyCornerInside = false;
    for (int i = 0; i < 8; i++)
    {
        vec3 toCorner = corners[i] - tipPos;
        float dist = length(toCorner);

        if (dist <= range)
        {
            if (dist < 0.001) // Point is at the cone tip
            {
                anyCornerInside = true;
                break;
            }

            float angle = dot(toCorner / dist, direction);
            // Use a slightly wider angle for more conservative culling
            if (angle >= cosAngle * 0.95)
            {
                anyCornerInside = true;
                break;
            }
        }
    }

    if (anyCornerInside)
        return true;

    // Check if AABB center is in cone
    vec3 center = (expandedMin + expandedMax) * 0.5;
    vec3 toCenter = center - tipPos;
    float centerDist = length(toCenter);

    if (centerDist <= range && centerDist > 0.001)
    {
        float centerAngle = dot(toCenter / centerDist, direction);
        if (centerAngle >= cosAngle * 0.95)
            return true;
    }

    // Check if cone axis passes through the AABB
    // Find closest point on cone axis to AABB
    float t = clamp(dot(center - tipPos, direction), 0.0, range);
    vec3 closestOnAxis = tipPos + direction * t;

    // Check if this point is inside the AABB
    if (all(greaterThanEqual(closestOnAxis, expandedMin)) && all(lessThanEqual(closestOnAxis, expandedMax)))
        return true;

    return false;
}

void main()
{
    // Each workgroup processes ONE cluster, so use WorkGroupID not GlobalInvocationID
    uvec3 clusterID = gl_WorkGroupID;

    if (clusterID.x >= uGridDimX || clusterID.y >= uGridDimY || clusterID.z >= uGridDimZ)
        return;

    uint clusterIndex = clusterID.z * uGridDimX * uGridDimY + clusterID.y * uGridDimX + clusterID.x;
    uint localThreadIndex = gl_LocalInvocationIndex;

    // Initialize shared memory
    if (localThreadIndex == 0)
    {
        sharedLightCount = 0;
    }
    barrier();

    ClusterAABB clusterAABB = clusters[clusterIndex];

    // Each thread tests a subset of lights
    for (uint i = localThreadIndex; i < uLightCount; i += gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z)
    {
        LightData light = lights[i];

        // Transform light position to view space
        vec3 viewSpacePos = (uViewMatrix * vec4(light.position, 1.0)).xyz;

        bool intersects = false;

        if (light.type == 0) // Point light
        {
            intersects = SphereIntersectsAABB(viewSpacePos, light.range, clusterAABB.minPoint, clusterAABB.maxPoint);
        }
        else if (light.type == 1) // Spot light
        {
            vec3 viewSpaceDir = mat3(uViewMatrix) * light.direction;
            intersects = ConeIntersectsAABB(viewSpacePos, viewSpaceDir, light.range, light.spotOuterAngle, clusterAABB.minPoint, clusterAABB.maxPoint);
        }

        if (intersects)
        {
            uint index = atomicAdd(sharedLightCount, 1);
            if (index < MAX_LIGHTS_PER_CLUSTER)
            {
                sharedLightIndices[index] = i;
            }
        }
    }

    barrier();

    // Write results to global memory (only first thread)
    if (localThreadIndex == 0)
    {
        uint lightCount = min(sharedLightCount, MAX_LIGHTS_PER_CLUSTER);

        if (lightCount > 0)
        {
            sharedGlobalOffset = atomicAdd(globalIndexCount, lightCount);
        }
        else
        {
            sharedGlobalOffset = 0;
        }

        clusterData[clusterIndex].offset = sharedGlobalOffset;
        clusterData[clusterIndex].count = lightCount;
    }

    barrier();

    // Write light indices
    uint lightCount = min(sharedLightCount, MAX_LIGHTS_PER_CLUSTER);
    for (uint i = localThreadIndex; i < lightCount; i += gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z)
    {
        lightIndices[sharedGlobalOffset + i] = sharedLightIndices[i];
    }
}
