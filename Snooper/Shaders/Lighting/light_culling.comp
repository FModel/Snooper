layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Injected as a #define from ClusteredLightSystem so it always matches the C# MaxLightsPerCluster
// used to size the light index buffer (each cluster owns a fixed slot of this many entries).
#ifndef MAX_LIGHTS_PER_CLUSTER
#define MAX_LIGHTS_PER_CLUSTER 128
#endif

#define LIGHT_BATCH 64 // must equal local_size_x

#include "Buffers/PerLightData.glsl"

struct ClusterAABB
{
    vec3 minPoint;
    vec3 maxPoint;
};

layout(std430, binding = BINDING_LIGHT_CLUSTER_AABBS) readonly buffer ClusterAABBs
{
    ClusterAABB clusters[];
};

uniform int uLightCount;
uniform int uGridDimX;
uniform int uGridDimY;
uniform int uGridDimZ;
uniform mat4 uViewMatrix;

// One batch of lights, pre-transformed to view space: xyz = center, w = range (< 0 => empty slot).
shared vec4 gBatchSpheres[LIGHT_BATCH];

bool SphereIntersectsAABB(vec3 center, float radius, vec3 minPoint, vec3 maxPoint)
{
    vec3 closest = clamp(center, minPoint, maxPoint);
    vec3 d = center - closest;
    return dot(d, d) <= radius * radius;
}

void main()
{
    uint clusterIndex = gl_GlobalInvocationID.x;
    uint localId = gl_LocalInvocationID.x;
    uint totalClusters = uint(uGridDimX * uGridDimY * uGridDimZ);
    uint lightCount = uint(max(uLightCount, 0));

    // Threads whose cluster is out of range (tail work group) must still take part in the cooperative
    // loads and barriers below; they simply don't accumulate or write anything.
    bool valid = clusterIndex < totalClusters;
    ClusterAABB aabb = clusters[valid ? clusterIndex : 0u];

    // Every light type is culled as a bounding sphere of radius = range around its position. The
    // fragment shader does the exact per-shape test, so an over-inclusive cull is always correct --
    // this is what makes rect lights behave (the old oriented-box test was too tight and dropped lit
    // clusters to the sides of the light).
    uint base = clusterIndex * uint(MAX_LIGHTS_PER_CLUSTER);
    uint count = 0u;

    for (uint batchStart = 0u; batchStart < lightCount; batchStart += uint(LIGHT_BATCH))
    {
        // Cooperatively load and transform one batch of lights into shared memory: each light is
        // transformed to view space once per work group instead of once per cluster.
        uint li = batchStart + localId;
        if (li < lightCount)
        {
            PerLightData light = lights[li];
            vec3 viewPos = (uViewMatrix * vec4(light.position, 1.0)).xyz;
            gBatchSpheres[localId] = vec4(viewPos, light.range);
        }
        else
        {
            gBatchSpheres[localId] = vec4(0.0, 0.0, 0.0, -1.0);
        }
        barrier();

        if (valid)
        {
            uint batchCount = min(uint(LIGHT_BATCH), lightCount - batchStart);
            for (uint j = 0u; j < batchCount && count < uint(MAX_LIGHTS_PER_CLUSTER); j++)
            {
                vec4 sphere = gBatchSpheres[j];
                if (sphere.w > 0.0 && SphereIntersectsAABB(sphere.xyz, sphere.w, aabb.minPoint, aabb.maxPoint))
                {
                    lightIndices[base + count] = batchStart + j;
                    count++;
                }
            }
        }
        barrier();
    }

    if (valid)
    {
        clusterData[clusterIndex].offset = base;
        clusterData[clusterIndex].count = count;
    }
}
