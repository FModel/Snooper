// built twice
#ifdef CULL_CHUNKED
layout(local_size_x = 32) in;

shared uint sMinVisible[32];
shared uint sMaxVisible[32];
shared float sClosestDist[32];
shared uint sAnyVisible[32];
#else
layout(local_size_x = CULL_GROUP_SIZE) in;
#endif

struct PrimitiveDescriptor // per-LOD data only, mesh-wide data lives in PerMeshData
{
    uvec4 firstIndex[2]; // EBO offsets for each LOD
    uvec4 baseVertex[2]; // VBO offsets for each LOD
    vec4 screenSize[2];
    uvec4 sectionCount[2]; // number of sections for each LOD
    uvec4 sectionOffset[2]; // section offsets for each LOD in SectionDescriptorsBuffer
    uvec4 baseColor[2]; // Color buffer offsets for each LOD
};

struct SectionDescriptor
{
    uint firstIndex;
    uint count;
    uint materialIndex;
};

#include "Buffers/PerDrawCommand.glsl"
#include "Buffers/PerDrawData.glsl"
#include "Buffers/PerInstanceData.glsl"
#include "Buffers/PerMeshData.glsl"

layout(std430, binding = BINDING_CULL_LOD_DATA) readonly buffer PrimitiveDescriptorsBuffer
{
    PrimitiveDescriptor uPrimitiveDescriptors[];
};

layout(std430, binding = BINDING_CULL_SECTIONS) buffer SectionDescriptorsBuffer
{
    SectionDescriptor uSectionDescriptors[];
};

#ifdef CULL_CHUNKED
layout(std430, binding = BINDING_CULL_CHUNKED) readonly buffer ChunkedDrawsBuffer
{
    uint uChunkedDraws[];
};
#endif

uniform vec4 uFrustumPlanes[MAX_CULLING_VIEWS * 6];
uniform vec4 uLodReference[MAX_CULLING_VIEWS];
uniform float uLodOrthoExtent[MAX_CULLING_VIEWS]; // > 0 marks the view orthographic, and is its half-width in world units

uniform uint uViewCount; // the views to cull, 0 the camera's, the rest shadow views
uniform uint uMaskView; // the outlined draws only, seen from view 0
uniform uint uViewCapacity;

bool isVisible(uint planeBase, vec3 center, vec3 extents)
{
    for (uint i = 0u; i < 6u; ++i)
    {
        vec4 plane = uFrustumPlanes[planeBase + i];
        vec3 normal = plane.xyz;
        float d = plane.w;

        float r = dot(abs(normal), extents);
        float s = dot(normal, center) + d;
        if (s < -r)
        {
            return false;
        }
    }
    return true;
}

bool isWithinDrawDistance(float minDistance, float maxDistance, float dist)
{
    if (dist < minDistance) return false;
    if (maxDistance > 0.0 && dist > maxDistance) return false;
    return true;
}

bool equals(DrawElementsIndirectCommand a, DrawElementsIndirectCommand b)
{
    return
        a.BaseInstance == b.BaseInstance &&
        a.InstanceCount == b.InstanceCount &&
        a.IndexCount == b.IndexCount &&
        a.FirstIndex == b.FirstIndex &&
        a.BaseVertex == b.BaseVertex;
}

bool testInstance(uint planeBase, PerDrawStatic draw, PerMeshData mesh, vec3 lodRefPos, bool trustBounds, uint instance, out float dist)
{
    mat4 modelMatrix = uInstanceDataBuffer[instance].Matrix;

    vec3 worldCenter = (modelMatrix * vec4(mesh.Center, 1.0)).xyz;
    mat3 m = mat3(modelMatrix);
    vec3 worldExtents = abs(m[0]) * mesh.Extents.x + abs(m[1]) * mesh.Extents.y + abs(m[2]) * mesh.Extents.z;

    dist = length(lodRefPos - worldCenter);
    return !trustBounds || (isVisible(planeBase, worldCenter, worldExtents) && isWithinDrawDistance(draw.MinDrawDistance, draw.MaxDrawDistance, dist));
}

void resolve(uint slot, uint cullView, PerDrawStatic draw, PerMeshData mesh, bool trustBounds, uint minVisible, uint maxVisible, float closestDist, bool anyVisible)
{
    DrawElementsIndirectCommand cmd = uDrawCommandBuffer[slot];
    PerDrawCulled culled = uDrawCulled[slot];

    DrawElementsIndirectCommand newCmd = cmd;
    uint newLod = culled.Lod;
    uint newMaterialIndex = culled.MaterialIndex;
    uint newBaseColor = culled.BaseColor;
    if (anyVisible)
    {
        PrimitiveDescriptor primitive = uPrimitiveDescriptors[draw.MeshIndex];

        newCmd.BaseInstance = draw.OriginalBaseInstance + minVisible;
        newCmd.InstanceCount = maxVisible - minVisible + 1;

        uint chosenLod = 0u;
        if (mesh.MaxLOD > 0u && trustBounds)
        {
            // Check if LOD override is set (>= 0)
            if (mesh.OverrideLod >= 0)
            {
                chosenLod = uint(mesh.OverrideLod);
            }
            else
            {
                // Automatic LOD selection based on screen size
                float lodScale = uLodReference[cullView].w;
                float lodOrthoExtent = uLodOrthoExtent[cullView];
                float screenRadius = lodOrthoExtent > 0.0
                    ? mesh.SphereRadius / lodOrthoExtent
                    : mesh.SphereRadius * lodScale / closestDist;
                float screenSize = screenRadius * 2.0;

                for (uint i = 1u; i <= mesh.MaxLOD; ++i)
                {
                    float threshold = primitive.screenSize[i / 4u][i % 4u];
                    if (screenSize < threshold)
                    {
                        chosenLod = i; // keep advancing while it still qualifies
                    }
                    else
                    {
                        break;
                    }
                }
            }
        }

        uint lod = clamp(chosenLod, 0u, mesh.MaxLOD);
        uint lodGroup = lod / 4u;
        uint lodSub = lod % 4u;

        uint sectionCount = primitive.sectionCount[lodGroup][lodSub];
        if (draw.SectionId >= sectionCount)
        {
            newCmd.InstanceCount = 0;
        }
        else
        {
            uint sectionOffset = primitive.sectionOffset[lodGroup][lodSub] + draw.SectionId;
            SectionDescriptor section = uSectionDescriptors[sectionOffset];

            newCmd.IndexCount = section.count;
            newCmd.FirstIndex = primitive.firstIndex[lodGroup][lodSub] + section.firstIndex;
            newCmd.BaseVertex = primitive.baseVertex[lodGroup][lodSub];

            newLod = lod;
            newMaterialIndex = section.materialIndex;
            newBaseColor = primitive.baseColor[lodGroup][lodSub];
        }
    }
    else
    {
        newCmd.InstanceCount = 0;
    }

    if (!equals(cmd, newCmd))
    {
        uDrawCommandBuffer[slot].IndexCount    = newCmd.IndexCount;
        uDrawCommandBuffer[slot].InstanceCount = newCmd.InstanceCount;
        uDrawCommandBuffer[slot].FirstIndex    = newCmd.FirstIndex;
        uDrawCommandBuffer[slot].BaseVertex    = newCmd.BaseVertex;
        uDrawCommandBuffer[slot].BaseInstance  = newCmd.BaseInstance;
    }

    if (newLod != culled.Lod || newMaterialIndex != culled.MaterialIndex || newBaseColor != culled.BaseColor)
    {
        uDrawCulled[slot].Lod           = newLod;
        uDrawCulled[slot].MaterialIndex = newMaterialIndex;
        uDrawCulled[slot].BaseColor     = newBaseColor;
    }
}

void main()
{
#ifdef CULL_CHUNKED
    uint entry = uChunkedDraws[gl_WorkGroupID.x];
    if (entry == 0u) return; // a freed entry
    uint drawId = entry - CHUNKED_DRAW_OFFSET;
#else
    uint drawId = gl_GlobalInvocationID.x;
#endif
    uint view = gl_WorkGroupID.y;

    bool maskView = view == uMaskView;
    bool shadowView = !maskView && view != 0u;
    if (drawId >= uViewCapacity || (!maskView && view >= uViewCount)) return;

    bool trustBounds = uViewCount > 0u; // if we call this with uViewCount == 0, we don't trust the bounds, won't cull anything, and lod will stay at what the upload set was
    uint cullView = maskView ? 0u : view;
    uint slot = view * uViewCapacity + drawId;
    uint planeBase = cullView * 6u;

    PerDrawStatic draw = uDrawStatic[drawId];
#ifndef CULL_CHUNKED
    if (draw.OriginalInstanceCount > MAX_INSTANCES_PER_THREAD) return; // the chunked dispatch takes it
#endif

    if ((shadowView && draw.CastShadow == 0u) || (maskView && draw.Outlined == 0u))
    {
        uDrawCommandBuffer[slot].InstanceCount = 0;
        return;
    }

    PerMeshData mesh = uMeshDataBuffer[draw.MeshIndex];
    uint instanceCount = draw.OriginalInstanceCount;
    uint baseInstance = draw.OriginalBaseInstance;
    vec3 lodRefPos = uLodReference[cullView].xyz;

    uint localMin = 0xFFFFFFFFu;
    uint localMax = 0;
    float localClosest = 3.402823e+38;
    uint localAny = 0u;

#ifdef CULL_CHUNKED
    uint threadId = gl_LocalInvocationID.x;
    uint threadCount = gl_WorkGroupSize.x;
    for (uint j = threadId; j < instanceCount; j += threadCount)
#else
    for (uint j = 0u; j < instanceCount; ++j)
#endif
    {
        float dist;
        if (testInstance(planeBase, draw, mesh, lodRefPos, trustBounds, baseInstance + j, dist))
        {
            localMin = min(localMin, j);
            localMax = max(localMax, j);
            localClosest = min(localClosest, dist);
            localAny = 1u;
        }
    }

#ifdef CULL_CHUNKED
    sMinVisible[threadId] = localMin;
    sMaxVisible[threadId] = localMax;
    sClosestDist[threadId] = localClosest;
    sAnyVisible[threadId] = localAny;
    barrier();

    // reduction
    for (uint offset = threadCount / 2u; offset > 0u; offset >>= 1u)
    {
        if (threadId < offset)
        {
            sMinVisible[threadId] = min(sMinVisible[threadId], sMinVisible[threadId + offset]);
            sMaxVisible[threadId] = max(sMaxVisible[threadId], sMaxVisible[threadId + offset]);
            sClosestDist[threadId] = min(sClosestDist[threadId], sClosestDist[threadId + offset]);
            sAnyVisible[threadId] |= sAnyVisible[threadId + offset];
        }
        barrier();
    }

    if (threadId != 0)
    {
        return;
    }

    resolve(slot, cullView, draw, mesh, trustBounds, sMinVisible[0], sMaxVisible[0], sClosestDist[0], sAnyVisible[0] == 1u);
#else
    resolve(slot, cullView, draw, mesh, trustBounds, localMin, localMax, localClosest, localAny == 1u);
#endif
}
